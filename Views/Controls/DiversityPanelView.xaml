<UserControl x:Class="Excalibur5.Views.Controls.DiversityPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Excalibur5.ViewModels.Diversity"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Border CornerRadius="6" BorderBrush="#1d4957" BorderThickness="1" Margin="0,4,0,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0a1821" Offset="0"/>
                <GradientStop Color="#07121a" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="18,8,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Diversity"
                       Foreground="#e0eef8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#7da0b8" FontSize="10" Margin="0,0,0,10"
                       Text="Vários contratos comprados juntos e tratados como um só: recover e virtual atuam sobre o líquido do grupo."/>

            <!-- Contracts list -->
            <ScrollViewer Grid.Row="2" MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Contracts}" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiversityContractRow}">
                        <Border CornerRadius="4" Background="#0e2230" BorderBrush="#1d4957"
                                BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                    <!-- Mercado -->
                                    <StackPanel Margin="0,0,12,6">
                                        <TextBlock Text="Mercado:" Foreground="#90b5c9" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox Style="{StaticResource DerivComboBox}"
                                                  Width="120" Height="30"
                                                  ItemsSource="{Binding Markets}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Symbol"
                                                  SelectedValue="{Binding Symbol, Mode=TwoWay}"
                                                  ToolTip="Mercado sintético">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DerivComboBoxItem}"/>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                    <!-- Tipo de contrato -->
                                    <StackPanel Margin="0,0,12,6">
                                        <TextBlock Text="Tipo:" Foreground="#90b5c9" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox Style="{StaticResource DerivComboBox}"
                                                  Width="130" Height="30"
                                                  ItemsSource="{Binding ContractTypes}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ContractType, Mode=TwoWay}"
                                                  ToolTip="Tipo de contrato">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DerivComboBoxItem}"/>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                    <!-- Barreira (dígito) -->
                                    <StackPanel Margin="0,0,12,6"
                                                Visibility="{Binding RequiresDigit, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Dígito:" Foreground="#90b5c9" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox Style="{StaticResource DerivComboBox}"
                                                  Width="64" Height="30"
                                                  ItemsSource="{Binding Digits}"
                                                  SelectedItem="{Binding BarrierDigit, Mode=TwoWay}"
                                                  ToolTip="Último dígito previsto (0-9)">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DerivComboBoxItem}"/>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </StackPanel>
                                    <!-- Duração: valor + unidade -->
                                    <StackPanel Margin="0,0,12,6">
                                        <TextBlock Text="Duração:" Foreground="#90b5c9" FontSize="10" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Style="{StaticResource DerivTextBox}"
                                                     Width="48" Height="30"
                                                     Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Duração"/>
                                            <ComboBox Style="{StaticResource DerivComboBox}"
                                                      Width="90" Height="30" Margin="6,0,0,0"
                                                      ItemsSource="{Binding AvailableDurationUnits}"
                                                      SelectedItem="{Binding DurationUnit, Mode=TwoWay}"
                                                      ToolTip="Unidade de tempo permitida pelo contrato">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource DurationUnitToLabel}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DerivComboBoxItem}"/>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Stake -->
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Entrada (Stake):" Foreground="#90b5c9" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBox Style="{StaticResource DerivTextBox}"
                                                 Width="90" Height="30"
                                                 MaxLength="10"
                                                 Text="{Binding StakeText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Valor da entrada em USD"/>
                                    </StackPanel>
                                </WrapPanel>
                                <Button Grid.Column="1" Width="26" Height="26"
                                        VerticalAlignment="Top" Margin="8,18,0,0"
                                        Cursor="Hand" ToolTip="Remover contrato"
                                        Background="Transparent" BorderThickness="0"
                                        FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.RemoveContractCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="CloseGlow" CornerRadius="6"
                                                        Background="#ff5555" Opacity="0">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="12"/>
                                                    </Border.Effect>
                                                </Border>
                                                <Border x:Name="CloseBg" CornerRadius="6"
                                                        Background="Transparent">
                                                    <TextBlock x:Name="CloseGlyph" Text="✕"
                                                               Foreground="#ff6b6b" FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseGlow" Property="Opacity" Value="0.6"/>
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#33ff5555"/>
                                                    <Setter TargetName="CloseGlyph" Property="Foreground" Value="#ff5555"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#55ff4040"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add contract -->
            <Button Grid.Row="3" HorizontalAlignment="Left" Margin="0,4,0,10"
                    Style="{StaticResource DerivAddButtonStyle}" Height="30"
                    Command="{Binding AddContractCommand}">
                <TextBlock Text="+ Adicionar contrato" Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- Coverage / guidance -->
            <Border Grid.Row="4" CornerRadius="4" Background="#0e2230" Padding="10,6" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CoverageText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding CoverageText}" TextWrapping="Wrap" Foreground="#c0d8e8" FontSize="10"/>
            </Border>

            <!-- Actions + signal mode + status -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Buy group button (same toggle style as Iniciar) -->
                <Button Grid.Column="0"
                        Style="{StaticResource DerivToggleButtonStyle}"
                        Width="130" Height="32"
                        Command="{Binding ExecuteGroupCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="Comprar Grupo" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox IsChecked="{Binding UseSignalMode}" Foreground="#c0d8e8" VerticalAlignment="Center"
                              Content="Modo por sinal"
                              ToolTip="Dispara o grupo automaticamente quando a estratégia gera um sinal acima da confiança"/>
                    <TextBlock Text="Conf. mín.:" Foreground="#90b5c9" FontSize="10" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox Style="{StaticResource DerivTextBox}"
                             Width="50" Height="28" VerticalAlignment="Center"
                             Text="{Binding ConfidenceThresholdText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Confiança mínima do sinal (0-1)"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="#a3b8cc" FontSize="10"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
